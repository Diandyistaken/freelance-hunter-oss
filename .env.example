# Freelance Hunter — ortam değişkenleri
# Bu dosyayı ".env" adıyla kopyala, değerleri oraya yaz. .env asla commit edilmez.
# Zorunlu olan yalnızca ilk blok; geri kalanı kullandığın kanala göre doldurulur.

# --- ZORUNLU ------------------------------------------------------------------
# Claude API — ilanları puanlar ve Türkçeye çevirir (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Telegram — Telegram'da @BotFather'a /newbot yaz, verdiği token'ı buraya koy.
# Chat ID: bota bir mesaj at, sonra https://api.telegram.org/bot<TOKEN>/getUpdates
# adresini aç, "chat":{"id": ...} içindeki sayıyı yaz.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- İSTEĞE BAĞLI: İLAN KANALLARI ----------------------------------------------
# Gmail — platformların (Upwork, Fiverr, Bionluk, Armut, LinkedIn…) sana attığı
# ilan bildirim maillerini okur. Google Cloud Console'da "Desktop app" tipi bir
# OAuth istemcisi oluştur, indirdiğin credentials.json'ı aşağıdaki klasöre koy,
# sonra bir kez: python run.py --auth
KISISEL_AJAN_DIR=./data/google

# Freelancer.com resmi geliştirici API'si (https://developers.freelancer.com)
FREELANCER_OAUTH_TOKEN=
# Hesabın "Verified by Freelancer" ise 1 yap (2500 USD üzeri ilanlar da gelir)
FREELANCER_VERIFIED=0

# --- İSTEĞE BAĞLI: İŞLETME RADARI ----------------------------------------------
# Radar merkezi (varsayılan İstanbul/Anadolu yakası) ve yarıçap
RADAR_LAT=40.9544
RADAR_LON=29.1029
RADAR_RADIUS_M=1500
# PageSpeed Insights — ücretsiz, kart istemez (https://developers.google.com/speed/docs/insights/v5/get-started)
PSI_API_KEY=
# Google Places — kapalıdır; açarsan ücretli olabilir
GOOGLE_PLACES_API_KEY=
PLACES_ENABLED=0

# --- İSTEĞE BAĞLI: DEMO SİTE YAYINLAMA (Cloudflare Pages, ücretsiz) -------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- İSTEĞE BAĞLI: PANELİ DIŞARIYA AÇARSAN ---------------------------------------
# Tanımlı değilse panel yalnız bu bilgisayardan (localhost) açılır.
# Bu üçünü apps/dashboard/.env.local dosyasına yaz.
# PANEL_SIFRE=
# PANEL_GIZLI=
# PANEL_EPOSTA=
